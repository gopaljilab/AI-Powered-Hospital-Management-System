# ==============================================================================
# HospitalX - AI-Powered Hospital Management System Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI-Powered Hospital Management System"

# Secret Key for JWT Authentication (Change in production!)
SECRET_KEY=hospitalx_super_secret_jwt_key_2026_dev_environment_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL or local SQLite fallback)
# ------------------------------------------------------------------------------
# Option A: Supabase Managed PostgreSQL (Recommended for cloud/production)
# Format: postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Supabase Direct: postgresql+psycopg2://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# DATABASE_URL=postgresql+psycopg2://postgres.example:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option B: Local SQLite development fallback (Used by default if unset)
DATABASE_URL=sqlite:///./hospital.db

# Supabase Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Official google-genai SDK)
# ------------------------------------------------------------------------------
# Obtain your free Gemini API key from: https://aistudio.google.com/app/apikey
# If left blank, the system automatically runs the built-in Rule-Based Hospital
# Assistant with zero disruption to functionality or clinical guardrails.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# CORS & Frontend URLs
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
VITE_API_URL=http://localhost:8000/api/v1
