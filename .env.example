# ==============================================================================
# HospitalX - AI-Powered Hospital Management System Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI-Powered Hospital Management System"

# Secret Key for JWT Authentication (Change in production!)
SECRET_KEY=hospitalx_super_secret_jwt_key_2026_dev_environment_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL or local SQLite fallback)
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hospitalx
# For local SQLite development (default):
DATABASE_URL=sqlite:///./hospital.db

# OpenAI API Key (Optional for intelligent function calling)
# If left blank, the application automatically uses the built-in
# Rule-Based Hospital Assistant with zero disruption to functionality.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CORS & Frontend URLs
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
VITE_API_URL=http://localhost:8000/api/v1
